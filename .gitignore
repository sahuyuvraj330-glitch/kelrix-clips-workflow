# Video, audio and image files stay out of this repo — except the finished
# Shorts in projects/, which are the point of the showcase.
*.mp4
!projects/**/*.mp4
*.mov
*.mp3
*.wav
*.m4a
*.png
!projects/**/*.png
*.jpg
!projects/**/*.jpg
*.jpeg
!projects/**/*.jpeg
*.webp
!projects/**/*.webp

# Credentials and local state
.env
*.pem
*.key
credentials*
__pycache__/
.DS_Store
